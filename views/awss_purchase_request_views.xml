<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_awss_purchase_request_form_sr_link" model="ir.ui.view">
        <field name="name">awss.purchase.request.form.sr.link</field>
        <field name="model">awss.purchase.request</field>
        <field name="inherit_id" ref="awss_purchase_request.view_awss_purchase_request_form"/>
        <field name="arch" type="xml">
            <field name="department_id" position="after">
                <field name="sr_workorder_id" readonly="1" invisible="not sr_workorder_id"/>
            </field>
            <div name="button_box" position="inside">
                <button name="action_view_sr_workorder" type="object"
                        class="oe_stat_button" icon="fa-wrench"
                        invisible="not sr_workorder_id">
                    <div class="o_stat_info">
                        <field name="sr_workorder_name" class="o_stat_value"/>
                        <span class="o_stat_text">Work Order</span>
                    </div>
                </button>
            </div>
        </field>
    </record>

    <record id="view_awss_purchase_request_list_sr_link" model="ir.ui.view">
        <field name="name">awss.purchase.request.list.sr.link</field>
        <field name="model">awss.purchase.request</field>
        <field name="inherit_id" ref="awss_purchase_request.view_awss_purchase_request_list"/>
        <field name="arch" type="xml">
            <field name="department_id" position="after">
                <field name="sr_workorder_id" optional="hide"/>
            </field>
        </field>
    </record>

</odoo>
